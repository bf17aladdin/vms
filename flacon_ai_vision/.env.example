# ===== ENVIRONMENT =====
APP_ENV=development
HOST=127.0.0.1
BACKEND_PORT=5003
DEBUG=True
RELOAD=True

# ===== DATABASE =====
# Local SQLite default for development/testing
DATABASE_URL=sqlite:///./data/falcon.db
# PostgreSQL example
# DATABASE_URL=postgresql+psycopg://falcon:falcon_ai_vision_pwd@127.0.0.1:5433/falcon_ai_vision

# ===== SECURITY =====
# Set a strong random value in production (at least 32 chars)
SECRET_KEY=change-me-in-production
# Optional rotation: allow previous secrets while tokens expire
SECRET_KEY_PREVIOUS=
# Comma-separated extra fallback secrets (optional)
SECRET_KEY_FALLBACKS=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_ROTATE=true

# ===== CORS =====
# Comma-separated list or JSON array
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5003
CORS_ALLOW_CREDENTIALS=true

# ===== HTTP SECURITY =====
# Comma-separated allowlist of hosts (optional)
ALLOWED_HOSTS=
# Enforce HTTPS in production (true/false)
REQUIRE_HTTPS=false
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# ===== FRONTEND =====
# website | spa
FRONTEND_MODE=website
SERVE_FRONTEND_FROM_BACKEND=true

# ===== SSL/HTTPS (uncomment if using separate SSL proxy) =====
# SSL_CERTFILE=/path/to/cert.pem
# SSL_KEYFILE=/path/to/key.pem

# ===== AI MODELS =====
MODEL_YOLOv8=true
FACE_RECOGNITION=true
VEHICLE_DETECTION=true
MODEL_CACHE_DIR=./models

# ===== PERFORMANCE =====
MAX_CONCURRENT_CONNECTIONS=50
FRAME_QUEUE_SIZE=100
WORKER_THREADS=4
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
VEHICLE_RECOG_CACHE_TTL_SEC=1.5
VEHICLE_RECOG_CACHE_MAX=512
VEHICLE_RECOG_CACHE_ALLOW_PERSIST=false

# ===== MONITORING =====
ENABLE_MONITORING=true
PROMETHEUS_METRICS_PORT=8000
MONITORING_INTERVAL_SECONDS=30
HEALTH_READY_TIMEOUT_MS=1200

# ===== LOGGING =====
LOG_JSON=true
REQUEST_LOGGING_ENABLED=true
LOG_FILE_PATH=logs/backend.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# ===== GRAFANA =====
GRAFANA_PASSWORD=admin

# ===== LOAD BALANCER / MICRO-SERVICES =====
LB_PORT=5003
# Local Redis optional (set if installed). Keep memory backend if not using Redis yet.
REDIS_URL=redis://127.0.0.1:6379/0
SERVICE_ROLE=api

# ===== GPU / IA =====
# Examples: cpu, cuda, cuda:0, cuda:1
AI_DEVICE=cpu
AI_GPU_DEVICE=cuda:0
AI_GPU_INDEX=0
NVIDIA_VISIBLE_DEVICES=all

# ===== FACE AI PIPELINE =====
FACE_MODEL_PACK=buffalo_l
FACE_CTX_ID=-1
FACE_MIN_SIZE=40
FACE_MATCH_THRESHOLD=0.62
FACE_MATCH_CACHE_TTL_SEC=20
FACE_REALTIME_STRIDE=5
FACE_PGVECTOR_ENABLED=true
FACE_PGVECTOR_DIM=512
FACE_USE_FR_FALLBACK=true
FACE_FR_MAX_SIDE=480
FACE_FR_UPSAMPLE=0
FACE_MASK_SCORE_THRESHOLD=0.30
FACE_MASK_MATCH_THRESHOLD=0.52
FACE_MASK_SWITCH_MARGIN=0.01
FACE_TRY_UPPER_ON_UNKNOWN=true
FACE_FORCE_UPPER_FACE=true
FACE_UPPER_CONFIDENCE_TRIGGER=0.85
# Optional fallback embedding size (auto 128 with face_recognition backend)
# FACE_FALLBACK_EMBEDDING_DIM=128
# Optional explicit ArcFace ONNX model path
ARCFACE_MODEL_PATH=

# ===== VEHICLE AI PIPELINE =====
VEHICLE_DETECT_MODEL=yolov8n.pt
VEHICLE_DETECT_MIN_CONF=0.35
VEHICLE_DETECT_MAX=8
# OCR backend selector: auto | easyocr | tesseract | lprnet
OCR_BACKEND=easyocr
VEHICLE_OCR_LANGS=en,fr,ar
VEHICLE_OCR_MIN_CONF=0.20
VEHICLE_DETECT_TIMEOUT_SEC=60
VEHICLE_PLATE_MAX_REGIONS=2
VEHICLE_OCR_MAX_INPUT_SIDE=960
VEHICLE_OCR_UPSCALE_TRIGGER_MAX_SIDE=380
VEHICLE_OCR_MAX_VARIANTS=4
VEHICLE_ANPR_PLATE_FALLBACK_ROIS=2
# Optional LPRNet OCR integration (inspired by smeyanoff/car-number-detection).
# Keep disabled until LPRNet code + weights are available locally.
VEHICLE_LPRNET_ENABLE=false
VEHICLE_LPRNET_PROJECT_DIR=
VEHICLE_LPRNET_WEIGHTS=
VEHICLE_LPRNET_MODULE=
VEHICLE_LPRNET_FACTORY=
VEHICLE_LPRNET_CHARS_FILE=
# Fallback charset if CHARS_FILE is empty:
# VEHICLE_LPRNET_CHARS=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ
VEHICLE_LPRNET_INPUT_WIDTH=94
VEHICLE_LPRNET_INPUT_HEIGHT=24
VEHICLE_LPRNET_MAX_VARIANTS=4
VEHICLE_LPRNET_BLANK_INDEX=
VEHICLE_LPRNET_DEVICE=cpu
VEHICLE_MILITARY_ALERT_ENABLED=true
VEHICLE_REGISTRY_CACHE_TTL_SEC=30
VEHICLE_MILITARY_MARGIN=0.05
VEHICLE_SNAPSHOT_QUALITY=88
VEHICLE_OCR_AGG_WINDOW_SEC=1.5
VEHICLE_OCR_AGG_MAX_SAMPLES=6
VEHICLE_OCR_AGG_DECAY_SEC=0.9
VEHICLE_OCR_AGG_MIN_SAMPLES=3
VEHICLE_OCR_AGG_MIN_STABILITY=0.65
VEHICLE_OCR_AGG_MIN_MARGIN=0.12
VEHICLE_RUNTIME_MIN_VEHICLE_CONF=0.45
VEHICLE_RUNTIME_MIN_PLATE_CONF=0.25
VEHICLE_RUNTIME_MIN_PLATE_CHARS=4
VEHICLE_RUNTIME_MIN_PLATE_DIGITS=2
VEHICLE_RUNTIME_STRICT_TN_PLATE=true
VEHICLE_ANPR_PLATE_ONLY_FALLBACK=true
# Lightweight multi-object tracking in modular vehicle pipeline
VEHICLE_TRACK_ENABLED=true
VEHICLE_TRACK_MAX_AGE_SEC=2.5
VEHICLE_TRACK_IOU_THRESHOLD=0.20
VEHICLE_TRACK_CENTER_DISTANCE_RATIO=1.8
VEHICLE_TRACKER_MODE=iou
VEHICLE_SORT_MATCH_IOU=0.20
VEHICLE_SORT_MATCH_DISTANCE_RATIO=1.8
# Optional tiny ONNX vehicle brand classifier (feature flag)
VEHICLE_TINY_BRAND_ONNX_ENABLE=false
VEHICLE_TINY_BRAND_ONNX_MODEL_PATH=
VEHICLE_TINY_BRAND_ONNX_LABELS_PATH=
# Optional CSV fallback if LABELS_PATH is not provided
VEHICLE_TINY_BRAND_ONNX_LABELS=
VEHICLE_TINY_BRAND_ONNX_INPUT_SIZE=112
VEHICLE_TINY_BRAND_ONNX_MIN_CONF=0.55
# Optional terrain ONNX heads (brand/color/model), same feature flag as above.
VEHICLE_TINY_TERRAIN_ONNX_BRAND_MODEL_PATH=
VEHICLE_TINY_TERRAIN_ONNX_BRAND_LABELS_PATH=
VEHICLE_TINY_TERRAIN_ONNX_COLOR_MODEL_PATH=
VEHICLE_TINY_TERRAIN_ONNX_COLOR_LABELS_PATH=
VEHICLE_TINY_TERRAIN_ONNX_MODEL_MODEL_PATH=
VEHICLE_TINY_TERRAIN_ONNX_MODEL_LABELS_PATH=
VEHICLE_TINY_TERRAIN_ONNX_INPUT_SIZE=112
VEHICLE_TINY_TERRAIN_BRAND_MIN_CONF=0.55
VEHICLE_TINY_TERRAIN_COLOR_MIN_CONF=0.45
VEHICLE_TINY_TERRAIN_MODEL_MIN_CONF=0.50
# Vehicle consistency score (explainable weighted score)
VEHICLE_CONSISTENCY_W_OCR=0.25
VEHICLE_CONSISTENCY_W_TRACKER=0.15
VEHICLE_CONSISTENCY_W_BRAND=0.20
VEHICLE_CONSISTENCY_W_COLOR=0.10
VEHICLE_CONSISTENCY_W_REGISTRY=0.20
VEHICLE_CONSISTENCY_W_ALIGNMENT=0.10
VEHICLE_CONSISTENCY_SMOOTHING_ALPHA=0.45
VEHICLE_CONSISTENCY_STREAM_MAX_AGE_SEC=4.0
# Rule-based anomaly engine (consistency+flags only)
VEHICLE_ANOMALY_ENABLE=true
VEHICLE_ANOMALY_MEDIUM_SCORE=0.60
VEHICLE_ANOMALY_HIGH_SCORE=0.45
VEHICLE_ANOMALY_CRITICAL_SCORE=0.30
VEHICLE_ANOMALY_MISMATCH_HIGH_COUNT=2
# Alert engine (rule-based, no ML)
VEHICLE_ALERT_ENGINE_ENABLE=true
VEHICLE_ALERT_COOLDOWN_SEC=30
VEHICLE_ALERT_FREQUENCY_WINDOW_SEC=300
VEHICLE_ALERT_SPAM_WINDOW_SEC=120
VEHICLE_ALERT_SPAM_MAX_EMITS=4
VEHICLE_ALERT_ESCALATE_HIGH_COUNT=3
VEHICLE_ALERT_ESCALATE_CRITICAL_COUNT=6
# Use modular pipeline in /api/vehicle/detect endpoint
VEHICLE_DETECT_USE_MODULAR=false
VEHICLE_ACCESS_MIN_CONF_ALLOW=0.85
VEHICLE_ACCESS_MIN_CONF_REVIEW=0.65
VEHICLE_ACCESS_REQUIRE_REGISTRY=true
# deny | review
VEHICLE_ACCESS_UNKNOWN_POLICY=deny
VEHICLE_ACCESS_ENABLE_VISUAL_CHECK=true
VEHICLE_ACCESS_VISUAL_MISMATCH_THRESHOLD=0.40
VEHICLE_ACCESS_VISUAL_WINDOW_MINUTES=120
VEHICLE_TAMPER_ENABLE=true
VEHICLE_TAMPER_BLACK_BRIGHTNESS_MAX=20
VEHICLE_TAMPER_BLACK_RATIO_MIN=0.92
VEHICLE_TAMPER_COVERED_STD_MAX=10
VEHICLE_TAMPER_EDGE_DENSITY_MIN=0.005
# RTSP capture guardrails (avoid long hangs on unreachable cameras)
CAMERA_OPEN_TIMEOUT_SEC=4
CAMERA_READ_TIMEOUT_SEC=4
# MediaMTX API base (for RTSP health checks)
MEDIAMTX_API_BASE=http://127.0.0.1:9997
# Optional overrides for classifier signals:
# MILITARY_PLATE_KEYWORDS=MIL,ARMY,ARMEE,MILITAIRE,DEFENSE,GENDARMERIE,FORCE
# CIVIL_PLATE_KEYWORDS=TUNIS,TN,CIVIL
# MILITARY_PLATE_REGEX=(^|\\W)M[0-9]{2,6}($|\\W)
# CIVIL_PLATE_REGEX=[0-9]{2,4}\\s*(TN|TUNIS)\\s*[0-9]{2,4}

# ===== CLUSTER STORAGE (MINIO) =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=falcon-ai-vision

# ===== APPLICATION SETTINGS =====
APP_NAME=Falcon AI Vision
APP_VERSION=1.0.0
APP_DESCRIPTION=Computer Vision Monitoring System

# ===== RATE LIMITING =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
# local-only default (no Docker dependency). Set redis://127.0.0.1:6379/0 if Redis is active.
RATE_LIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT_ATTEMPTS=15
LOGIN_RATE_LIMIT_WINDOW_SEC=60

# ===== ASYNC QUEUE =====
ASYNC_QUEUE_BACKEND=local
ASYNC_QUEUE_NAME=vehicle-recognition
ASYNC_QUEUE_WORKERS=3

# ===== VIDEO RECORDING =====
# Delete recordings older than N days (0 disables age-based deletion).
VIDEO_RETENTION_DAYS=30
# Internal scheduler for purge/orphan cleanup.
VIDEO_AUTO_PURGE_ENABLED=true
VIDEO_PURGE_INTERVAL_SECONDS=3600
# Delay before removing orphan .mp4 files (no DB metadata).
VIDEO_ORPHAN_FILE_GRACE_SECONDS=300
# Startup retries when camera stream is temporarily unavailable.
VIDEO_START_MAX_RETRIES=3
VIDEO_START_RETRY_DELAY_SECONDS=0.35


# API Configuration
API_TITLE=Falcon AI Vision
API_VERSION=1.0.0
DEBUG=True
# Frontend auth behavior
# In production, default is true if this variable is unset.
# Set to "false" to keep existing sessions after browser/app restart.
VITE_FORCE_LOGIN_ON_START=true
