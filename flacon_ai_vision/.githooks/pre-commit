#!/bin/sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
PRECHECK="$REPO_ROOT/scripts/preflight.ps1"

if [ ! -f "$PRECHECK" ]; then
  echo "pre-commit: missing scripts/preflight.ps1"
  exit 1
fi

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$PRECHECK" -Mode pre-commit
fi

if command -v powershell >/dev/null 2>&1; then
  exec powershell -NoProfile -ExecutionPolicy Bypass -File "$PRECHECK" -Mode pre-commit
fi

echo "pre-commit: PowerShell is required to run scripts/preflight.ps1"
exit 1
